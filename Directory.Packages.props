<Project>
  <PropertyGroup>
    <!-- Enable Central Package Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ==================== SimpleIdServer Ecosystem (7.0.0) ==================== -->
  <ItemGroup>
    <!-- 核心 -->
    <PackageVersion Include="SimpleIdServer.IdServer" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Store.EF" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.Configuration" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.Configuration.Redis" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.Did.Key" Version="7.0.0" />

    <!-- 认证方式 -->
    <PackageVersion Include="SimpleIdServer.IdServer.Pwd" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Email" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Sms" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Otp" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Fido" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.VerifiablePresentation" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Saml.Idp" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.WsFederation" Version="7.0.0" />

    <!-- 通知推送 -->
    <PackageVersion Include="SimpleIdServer.IdServer.Notification.Fcm" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Notification.Gotify" Version="7.0.0" />

    <!-- 存储迁移 -->
    <PackageVersion Include="SimpleIdServer.IdServer.PostgreMigrations" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.SqlServerMigrations" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.MySQLMigrations" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.SqliteMigrations" Version="7.0.0" />

    <!-- 外部身份源 -->
    <PackageVersion Include="SimpleIdServer.IdServer.Provisioning.SCIM" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Provisioning.LDAP" Version="7.0.0" />

    <!-- Federation / 迁移 -->
    <PackageVersion Include="SimpleIdServer.IdServer.Federation" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Migrations" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Migrations.Duende" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Migrations.Openiddict" Version="7.0.0" />

    <!-- Swagger / OpenTelemetry / Admin -->
    <PackageVersion Include="SimpleIdServer.IdServer.Swagger" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.OpenTelemetry" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Website" Version="7.0.0" />
    <PackageVersion Include="SimpleIdServer.IdServer.Website.OpenTelemetry" Version="7.0.0" />

    <!-- SidFormBuilder -->
    <PackageVersion Include="SidFormBuilder.Tailwindcss" Version="7.0.0" />
    <PackageVersion Include="SidFormBuilder.PostgreMigrations" Version="7.0.0" />
    <PackageVersion Include="SidFormBuilder.SqlServerMigrations" Version="7.0.0" />
    <PackageVersion Include="SidFormBuilder.MySQLMigrations" Version="7.0.0" />
    <PackageVersion Include="SidFormBuilder.SqliteMigrations" Version="7.0.0" />
  </ItemGroup>

  <!-- ==================== Entity Framework Core ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.CommandLine" Version="9.0.4" />
    <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

  <!-- ==================== PostgreSQL ==================== -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageVersion Include="Npgsql" Version="9.0.3" />
  </ItemGroup>

  <!-- ==================== 分布式缓存 ==================== -->
  <ItemGroup>
    <PackageVersion Include="Community.Microsoft.Extensions.Caching.PostgreSql" Version="4.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Caching.SqlServer" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.4" />
    <PackageVersion Include="NeoSmart.Caching.Sqlite.AspNetCore" Version="8.0.0" />
    <PackageVersion Include="Pomelo.Extensions.Caching.MySql" Version="2.2.0" />
  </ItemGroup>

  <!-- ==================== 后台任务（Hangfire） ==================== -->
  <ItemGroup>
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.20.10" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.18" />
    <PackageVersion Include="Hangfire.MySqlStorage" Version="2.0.3" />
    <PackageVersion Include="Hangfire.SQLite" Version="1.4.2" />
  </ItemGroup>

  <!-- ==================== 消息队列（MassTransit） ==================== -->
  <ItemGroup>
    <PackageVersion Include="MassTransit.SqlTransport.SqlServer" Version="8.4.0" />
  </ItemGroup>

  <!-- ==================== OpenTelemetry ==================== -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.15.3-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.1-beta.1" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>

  <!-- ==================== ASP.NET Core 外部认证 ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Facebook" Version="9.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="9.0.4" />
  </ItemGroup>

  <!-- ==================== 开发工具 ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Web.LibraryManager.Build" Version="2.1.175" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.4" />
  </ItemGroup>

  <!-- ==================== CLI ==================== -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <!-- ==================== 健康检查 ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <!-- ==================== Serilog 结构化日志 ==================== -->
  <ItemGroup>
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <!-- ==================== 安全修复（传递依赖固定版本） ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.4" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.6" />
  </ItemGroup>

  <!-- ==================== 测试（预留） ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
