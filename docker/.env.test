# =============================================================================
# MinGo.Identity - Integration Test Environment Variables
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mingo_identity_test
PG_PORT=5433

# IdServer
IDSERVER_PORT=5001
AUTHORITY=http://idserver.local:8080
ADMIN_UI_URL=http://admin.local:8080
STORAGE_TYPE=POSTGRE

# Admin
ADMIN_PORT=5002
IDSERVER_BASE_URL=http://idserver:5001
ADMIN_CLIENT_ID=SIDS-manager
ADMIN_CLIENT_SECRET=password

# Nginx
HTTP_PORT=8080
HTTPS_PORT=8443

# Features
IS_REALM_ENABLED=true
IS_FORWARDED_ENABLED=true
IGNORE_CERT_ERROR=true
