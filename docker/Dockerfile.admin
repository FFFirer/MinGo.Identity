# =============================================================================
# MinGo Identity - Admin
# Multi-stage Docker build for the SimpleIdServer Admin Blazor dashboard
# =============================================================================

# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files for restore (layer caching optimization)
COPY Directory.Build.props Directory.Packages.props nuget.config MinGo.Identity.slnx ./
COPY src/MinGo.Identity.Configuration/MinGo.Identity.Configuration.csproj src/MinGo.Identity.Configuration/
COPY src/MinGo.Identity.Migrations/MinGo.Identity.Migrations.csproj src/MinGo.Identity.Migrations/
COPY src/MinGo.Identity.Migrator/MinGo.Identity.Migrator.csproj src/MinGo.Identity.Migrator/
COPY src/MinGo.IdServer/MinGo.IdServer.csproj src/MinGo.IdServer/
COPY src/MinGo.IdServer.Admin/MinGo.IdServer.Admin.csproj src/MinGo.IdServer.Admin/
COPY tests/MinGo.Identity.Migrator.IntegrationTests/MinGo.Identity.Migrator.IntegrationTests.csproj tests/MinGo.Identity.Migrator.IntegrationTests/
COPY tests/MinGo.Identity.UnitTests/MinGo.Identity.UnitTests.csproj tests/MinGo.Identity.UnitTests/

# Restore with cached packages
RUN dotnet restore 

# Copy source and publish
COPY . .
RUN ls -la 
RUN dotnet build src/MinGo.IdServer.Admin/MinGo.IdServer.Admin.csproj \
    -c Release \
    --no-restore 

RUN dotnet publish src/MinGo.IdServer.Admin/MinGo.IdServer.Admin.csproj \
    -c Release \
    -o /app/publish \
    --no-build

RUN ls -la /app/publish/wwwroot/
RUN ls -la /app/publish/wwwroot/_framework/ || echo "❌ _framework NOT GENERATED"

# Stage 2: Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install ICU globalization support (SimpleIdServer requires CultureInfo)
# Use Aliyun mirror for faster downloads in China mainland network environment
# Handle both Debian (aspnet:9.0-) and Ubuntu (aspnet:10.0+) base images
RUN if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    elif [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list.d/ubuntu.sources; \
    elif [ -f /etc/apt/sources.list ]; then \
        sed -i 's|http://archive.ubuntu.com/ubuntu/|http://mirrors.aliyun.com/ubuntu/|g;s|http://deb.debian.org/debian/|http://mirrors.aliyun.com/debian/|g' /etc/apt/sources.list; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        wget \
        # icu-libs \
    && rm -rf /var/lib/apt/lists/*
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0

# Create non-root user
RUN groupadd --system mingo && useradd --system --gid mingo mingo
USER mingo

# Copy published artifacts
COPY --from=build --chown=mingo:mingo /app/publish .

# Environment
ENV ASPNETCORE_URLS=http://+:5002
ENV ASPNETCORE_ENVIRONMENT=Production

# Health check is defined in docker-compose.prod.yml (not in Dockerfile)
# to keep the image agnostic of orchestration-specific probe configuration.
EXPOSE 5002

ENTRYPOINT ["dotnet", "MinGo.IdServer.Admin.dll"]
