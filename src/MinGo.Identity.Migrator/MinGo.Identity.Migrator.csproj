<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>MinGo.Identity.Migrator</RootNamespace>
		<AssemblyName>MinGo.Identity.Migrator</AssemblyName>
		<!-- Suppress NU1608: Pomelo.EntityFrameworkCore.MySql 8.0.2 (transitive from SidFormBuilder) 
		     conflicts with EF Core 10.x. Known issue - unfixable until Pomelo 10.x is released. -->
		<NoWarn>NU1608</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MinGo.Identity.Migrator.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\MinGo.Identity.Configuration\MinGo.Identity.Configuration.csproj" />
		<ProjectReference Include="..\MinGo.Identity.Migrations\MinGo.Identity.Migrations.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SimpleIdServer.IdServer" />
		<PackageReference Include="SimpleIdServer.IdServer.Migrations" />
		<PackageReference Include="SimpleIdServer.IdServer.Store.EF" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="System.CommandLine" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- 数据库迁移程序集：全部后端，运行时由 StorageConfiguration 切换  -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<!-- SimpleIdServer IdServer -->
		<PackageReference Include="SimpleIdServer.IdServer.PostgreMigrations" />
		<PackageReference Include="SimpleIdServer.IdServer.SqlServerMigrations" />
		<PackageReference Include="SimpleIdServer.IdServer.SqliteMigrations" />
		<!-- SidFormBuilder -->
		<PackageReference Include="SidFormBuilder.PostgreMigrations" />
		<PackageReference Include="SidFormBuilder.SqlServerMigrations" />
		<PackageReference Include="SidFormBuilder.SqliteMigrations" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>