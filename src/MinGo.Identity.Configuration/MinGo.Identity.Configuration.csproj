<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>MinGo.Identity.Configuration</RootNamespace>
		<AssemblyName>MinGo.Identity.Configuration</AssemblyName>
		<Description>Shared configuration models and helpers for MinGo Identity</Description>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<!-- <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" /> -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
		<!-- <PackageReference Include="Microsoft.Extensions.Configuration" /> -->
		<!-- <PackageReference Include="Microsoft.Extensions.Configuration.Binder" /> -->
		<!-- <PackageReference Include="Microsoft.Extensions.Configuration.Json" /> -->

		<!-- 健康检查数据库客户端 -->
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="StackExchange.Redis" />

		<!-- 覆盖 Microsoft.EntityFrameworkCore.Sqlite 传递依赖的 SQLitePCLRaw 2.x 漏洞包 (GHSA-2m69-gcr7-jv3q) -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
	</ItemGroup>
</Project>
