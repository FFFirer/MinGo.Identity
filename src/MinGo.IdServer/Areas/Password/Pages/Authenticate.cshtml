@page
@model SimpleIdServer.IdServer.Pwd.AuthenticatePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "登录 - MinGo Identity";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Custom Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gradient-to-br from-brand-50 to-blue-100 min-h-screen flex items-center justify-center">
    <div class="max-w-md w-full mx-4">
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <!-- Logo -->
            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold text-gray-900">MinGo Identity</h1>
                <p class="mt-2 text-gray-600">统一身份认证中心</p>
            </div>

            <!-- Login Form -->
            <form method="post" class="space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>
                
                <div>
                    <label asp-for="Login" class="block text-sm font-medium text-gray-700 mb-1">
                        用户名 / 邮箱
                    </label>
                    <input asp-for="Login" 
                           class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                           placeholder="请输入用户名" />
                    <span asp-validation-for="Login" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div>
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-1">
                        密码
                    </label>
                    <input asp-for="Password" type="password"
                           class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-brand-500 focus:border-transparent transition"
                           placeholder="请输入密码" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs mt-1"></span>
                </div>

                <div class="flex items-center justify-between">
                    <label class="flex items-center">
                        <input type="checkbox" class="rounded border-gray-300 text-brand-600 focus:ring-brand-500" />
                        <span class="ml-2 text-sm text-gray-600">记住我</span>
                    </label>
                    <a href="/Account/ForgotPassword" class="text-sm text-brand-600 hover:text-brand-700">
                        忘记密码？
                    </a>
                </div>

                <button type="submit" 
                        class="w-full py-3 px-4 bg-brand-600 hover:bg-brand-700 text-white font-medium rounded-lg transition duration-200 shadow-lg hover:shadow-xl">
                    登录
                </button>
            </form>

            <p class="mt-8 text-center text-sm text-gray-600">
                还没有账号？
                <a href="/Account/Register" class="text-brand-600 hover:text-brand-700 font-medium">
                    立即注册
                </a>
            </p>
        </div>
    </div>
</body>
</html>
