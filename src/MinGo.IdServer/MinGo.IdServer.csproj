<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<AssemblyName>MinGo.IdServer</AssemblyName>
		<RootNamespace>MinGo.IdServer</RootNamespace>
		<UserSecretsId>mingo-identity-idserver-2026</UserSecretsId>
	</PropertyGroup>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- SimpleIdServer 核心框架                                        -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<!-- 核心包：OIDC/OAuth2/UMA/CIBA 协议实现 -->
		<PackageReference Include="SimpleIdServer.IdServer" />
		<!-- EF Core 存储层 -->
		<PackageReference Include="SimpleIdServer.IdServer.Store.EF" />
		<!-- 配置管理 -->
		<PackageReference Include="SimpleIdServer.Configuration" />
		<!-- OpenTelemetry 可观测性集成 -->
		<PackageReference Include="SimpleIdServer.IdServer.OpenTelemetry" />
	</ItemGroup>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- 内部项目引用                                                    -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<ProjectReference Include="..\MinGo.Identity.Configuration\MinGo.Identity.Configuration.csproj" />
	</ItemGroup>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- 认证方式                                                       -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<!-- ✅ 当前启用 -->
		<PackageReference Include="SimpleIdServer.IdServer.Pwd" />       <!-- 密码认证 -->
		<PackageReference Include="SimpleIdServer.IdServer.Email" />     <!-- 邮箱验证码 -->
		<PackageReference Include="SimpleIdServer.IdServer.Sms" />       <!-- 短信验证码 -->
		<PackageReference Include="SimpleIdServer.IdServer.Otp" />       <!-- OTP 一次性密码 -->
		<PackageReference Include="SimpleIdServer.IdServer.Fido" />      <!-- FIDO2/WebAuthn -->
		<PackageReference Include="SimpleIdServer.IdServer.VerifiablePresentation" />  <!-- 可验证凭证(VP) -->

		<!-- 通知推送 -->
		<PackageReference Include="SimpleIdServer.IdServer.Notification.Fcm" />     <!-- Firebase Cloud Messaging -->
		<PackageReference Include="SimpleIdServer.IdServer.Notification.Gotify" />  <!-- Gotify 自托管推送 -->
	</ItemGroup>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- 数据库迁移（模板代码引用多后端，仅 PostgreSQL 运行时使用）      -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<PackageReference Include="SimpleIdServer.IdServer.PostgreMigrations" />    <!-- ✅ PostgreSQL 主存储 -->
		<PackageReference Include="SidFormBuilder.PostgreMigrations" />            <!-- ✅ FormBuilder PostgreSQL -->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />       <!-- ✅ Npgsql EF Core -->
		<PackageReference Include="Community.Microsoft.Extensions.Caching.PostgreSql" />  <!-- ✅ PG 分布式缓存 -->

		<!-- 以下为模板 SidServerSetup 代码引用的其他后端（保持编译通过，运行时由配置切换） -->
		<PackageReference Include="SimpleIdServer.IdServer.SqlServerMigrations" />
		<PackageReference Include="SimpleIdServer.IdServer.MySQLMigrations" />
		<PackageReference Include="SimpleIdServer.IdServer.SqliteMigrations" />
		<PackageReference Include="SidFormBuilder.SqlServerMigrations" />
		<PackageReference Include="SidFormBuilder.MySQLMigrations" />
		<PackageReference Include="SidFormBuilder.SqliteMigrations" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
		<PackageReference Include="Pomelo.Extensions.Caching.MySql" />
		<PackageReference Include="NeoSmart.Caching.Sqlite.AspNetCore" />
		<PackageReference Include="Microsoft.Extensions.Caching.SqlServer" />
	</ItemGroup>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- 企业级扩展（模板代码引用，默认关闭）                            -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<!-- 外部身份提供商（Converters/* + ConfigureAuthSchemeProvider 模板代码引用） -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" />

		<!-- SAML2 / WsFederation / OpenID Federation / DID -->
		<PackageReference Include="SimpleIdServer.IdServer.Saml.Idp" />
		<PackageReference Include="SimpleIdServer.IdServer.WsFederation" />
		<PackageReference Include="SimpleIdServer.IdServer.Federation" />
		<PackageReference Include="SimpleIdServer.Did.Key" />

		<!-- 外部身份源（SCIM/LDAP 同步） -->
		<PackageReference Include="SimpleIdServer.IdServer.Provisioning.SCIM" />
		<PackageReference Include="SimpleIdServer.IdServer.Provisioning.LDAP" />

		<!-- 从 Duende IdentityServer / OpenIddict 迁移 -->
		<PackageReference Include="SimpleIdServer.IdServer.Migrations.Duende" />
		<PackageReference Include="SimpleIdServer.IdServer.Migrations.Openiddict" />
	</ItemGroup>

	<!-- ════════════════════════════════════════════════════════════════ -->
	<!-- 基础设施                                                       -->
	<!-- ════════════════════════════════════════════════════════════════ -->
	<ItemGroup>
		<PackageReference Include="SidFormBuilder.Tailwindcss" />   <!-- UI：Tailwind CSS -->
		<PackageReference Include="SimpleIdServer.IdServer.Swagger" />  <!-- Swagger API 文档 -->
		<PackageReference Include="SimpleIdServer.Configuration.Redis" />  <!-- Redis 配置（模板引用，默认 INMEMORY） -->
		<PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />  <!-- Redis 缓存 -->

		<!-- 后台任务 Hangfire（模板引用多后端，仅 PostgreSQL 运行时使用） -->
		<PackageReference Include="Hangfire.PostgreSql" />
		<PackageReference Include="Hangfire.SqlServer" />
		<PackageReference Include="Hangfire.MySqlStorage" />
		<PackageReference Include="Hangfire.SQLite" />

		<!-- 消息队列 MassTransit（模板引用，默认 INMEMORY） -->
		<PackageReference Include="MassTransit.SqlTransport.SqlServer" />

		<!-- Serilog 结构化日志 -->
		<PackageReference Include="Serilog.AspNetCore" />

		<!-- OpenTelemetry 导出器（模板代码引用，默认关闭） -->
		<PackageReference Include="OpenTelemetry.Exporter.Console" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
		<PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />

		<!-- EF Core 工具（仅开发时） -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

