{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Components": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [ { "Name": "Console" } ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForceHttps": false,
  "IsForwardedEnabled": true,
  "IsRealmEnabled": true,
  "IdserverBaseUrl": "https://localhost:5001",
  "BackchannelBaseUrl": "",
  "BackchannelTimeoutSeconds": 15,
  "ScimBaseUrl": "localhost",
  "ClientId": "SIDS-manager",
  "ClientSecret": "password",
  "Scopes": [
    "openid",
    "profile",
    "role"
  ],
  "IgnoreCertificateError": true,
  "DetailedErrors": true,
  "OpenTelemetryOptions": {
    "EnableOtpExported": false,
    "EnableConsoleExporter": false
  }
}
