<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>MinGo.IdServer.Admin</AssemblyName>
		<RootNamespace>MinGo.IdServer.Admin</RootNamespace>
		<UserSecretsId>mingo-identity-admin-2026</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<!-- SimpleIdServer Admin 管理后台（Blazor Interactive Server） -->
		<PackageReference Include="NSwag.AspNetCore" />
		<PackageReference Include="SimpleIdServer.IdServer.Website" />
		<PackageReference Include="SimpleIdServer.IdServer.Website.OpenTelemetry" />

		<!-- Fluxor 6.9.0: 覆盖 SimpleIdServer 传递依赖的 6.1.0，修复 .NET 10 兼容性和 ReduxDevTools NRE -->
		<!-- <PackageReference Include="Fluxor" /> -->
		<!-- <PackageReference Include="Fluxor.Blazor.Web" /> -->
		<!-- <PackageReference Include="Fluxor.Blazor.Web.ReduxDevTools" /> -->

		<!-- LibMan 前端库管理 — 取消注释以启用
		<PackageReference Include="Microsoft.Web.LibraryManager.Build" />
		-->

			<!-- Serilog 结构化日志 -->
		<PackageReference Include="Serilog.AspNetCore" />

		<!-- OpenTelemetry 导出器（模板 IdentityServerAdminConfiguration 代码引用） -->
		<PackageReference Include="OpenTelemetry.Exporter.Console" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
		<PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MinGo.Identity.Configuration\MinGo.Identity.Configuration.csproj" />
	</ItemGroup>
</Project>
